{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "▶ Run Drishti Host (VS Code)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/main.py",
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "🌐 Launch Drishti Web App in Browser",
      "type": "chrome",
      "request": "launch",
      "url": "http://localhost:5173",
      "webRoot": "${workspaceFolder}/frontend-drishti"
    }
  ]
}
