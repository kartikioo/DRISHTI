# DRISHTI Backend Configuration
PORT=5001
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Security & Authentication
JWT_SECRET=drishti_super_secure_jwt_secret_key_accessibility_2026_change_in_production
JWT_EXPIRES_IN=7d

# Supabase (PostgreSQL Database & Object Storage)
# Sign up at https://supabase.com to create your free project
SUPABASE_URL=https://your-supabase-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_STORAGE_BUCKET=drishti-images

# Provider-Independent AI Configuration
# Examples:
# For Google Gemini Vision (leave AI_API_URL empty for standard default):
#   AI_PROVIDER=gemini
#   AI_API_KEY=YOUR_GEMINI_API_KEY
#   AI_MODEL=gemini-1.5-flash
#   AI_API_URL=
AI_PROVIDER=gemini
AI_API_KEY=
AI_MODEL=gemini-1.5-flash
AI_API_URL=

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
AI_RATE_LIMIT_MAX_REQUESTS=30
